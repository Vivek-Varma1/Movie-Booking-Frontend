# Example environment variables for this project.
# Copy this file to `.env.local` for local development, and add the same key
# in Vercel under Project Settings > Environment Variables for deployment.

# Public API base URL for the backend the frontend talks to.
# Use your production API URL in Vercel, for example:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
